generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth tables ────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ── App user ───────────────────────────────────────────────────────────────────

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String?
  avatarUrl  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  memories          AgentMemory[]
  analyses          Analysis[]
  threadMetas       ThreadMeta[]
  userLabels        UserLabel[]
  automationActions AutomationAction[]
  automationSetting AutomationSetting?
  agentRuns         AgentRun[]

  @@map("users")
}

// ── Agent memory ───────────────────────────────────────────────────────────────

enum MemoryCategory {
  sender_preference
  priority_rule
  scheduling_preference
  writing_style
  automation_rule
  general
}

model AgentMemory {
  id            String         @id @default(uuid())
  userId        String
  category      MemoryCategory
  key           String
  value         String
  confidence    Float          @default(1.0)
  sourceMessage String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, key])
  @@index([userId])
  @@index([userId, category])
  @@map("agent_memory")
}

// ── Thread analysis cache ──────────────────────────────────────────────────────

model Analysis {
  id             String   @id @default(cuid())
  userId         String
  threadId       String
  gmailThreadId  String
  analysisData   Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId])
  @@map("analyses")
}

// ── Thread metadata ────────────────────────────────────────────────────────────

model ThreadMeta {
  id        String   @id @default(cuid())
  userId    String
  threadId  String
  meta      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId])
  @@map("thread_meta")
}

// ── User labels ────────────────────────────────────────────────────────────────

model UserLabel {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("user_labels")
}

// ── Automation ─────────────────────────────────────────────────────────────────

enum RiskLevel {
  auto
  confirm
  notify
}

enum ActionStatus {
  pending
  approved
  rejected
  executed
  undone
}

model AutomationAction {
  id            String       @id @default(uuid())
  userId        String
  threadId      String
  type          String
  riskLevel     RiskLevel
  status        ActionStatus @default(pending)
  payload       Json         @default("{}")
  reason        String       @default("")
  threadSubject String?
  threadFrom    Json?
  createdAt     DateTime     @default(now())
  executedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, riskLevel])
  @@map("automation_actions")
}

model AutomationSetting {
  userId    String   @id
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("automation_settings")
}

// ── LangGraph agent runs (Phase 3) ─────────────────────────────────────────────

enum RunStatus {
  running
  completed
  interrupted
  failed
}

model AgentRun {
  id          String    @id @default(cuid())
  userId      String
  graphName   String
  status      RunStatus @default(running)
  threadId    String?
  checkpointId String?
  result      Json?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvalRequests ApprovalRequest[]

  @@index([userId])
  @@index([userId, status])
  @@map("agent_runs")
}

// ── Human-in-the-loop approval requests (Phase 3) ─────────────────────────────

model ApprovalRequest {
  id          String    @id @default(cuid())
  agentRunId  String
  userId      String
  actionType  String
  payload     Json
  status      ActionStatus @default(pending)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("approval_requests")
}
