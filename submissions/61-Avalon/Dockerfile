# MailMate web — multi-stage Dockerfile
#
# STAGES:
#   base    — shared node:20-alpine foundation
#   deps    — install npm dependencies only (cached separately from source)
#   builder — build the Next.js standalone output
#   runner  — minimal production image (no dev deps, no source, no build cache)
#
# WHY MULTI-STAGE?
#   The final runner image contains only:
#     - The compiled Next.js standalone server (server.js)
#     - Public static assets
#     - Built .next/static files
#   It does NOT contain node_modules, source files, or build tools.
#   This makes the runner image ~60% smaller than a naive single-stage build.
#
# STANDALONE OUTPUT (next.config.mjs: output: 'standalone'):
#   Next.js traces only the modules actually used at runtime and bundles them
#   into .next/standalone/. The runner stage copies this directory and runs
#   node server.js directly — no `next start` or `npm` needed at runtime.
#
# NON-ROOT USER:
#   The runner creates a "nextjs" system user (uid 1001) and runs as that user.
#   This follows Docker security best practices — the process cannot write to
#   system directories even if it is compromised.
#
# HEALTHCHECK:
#   Docker sends a GET /api/health every 30s. If it fails 3 times in a row,
#   the container is marked unhealthy and docker-compose replaces it (restart
#   policy: unless-stopped). The web /api/health endpoint probes Postgres,
#   Redis, and the agent-service so this healthcheck covers the full stack.
#
# BUILD ARGS:
#   No build args are defined here. All configuration comes from environment
#   variables at runtime (env_file in docker-compose.yml). This means the same
#   image can be used for staging and production by changing only the .env file.
#
# USAGE:
#   Build:  docker build . --target runner -t mailmate-web
#   Run:    docker run -p 3000:3000 --env-file .env mailmate-web

FROM node:20-alpine AS base

# ── Stage 1: Install dependencies ─────────────────────────────────────────────
FROM base AS deps
# libc6-compat is required for certain npm packages on Alpine (musl libc)
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy package files first — Docker caches this layer until package.json changes
COPY package.json package-lock.json ./
# npm ci installs exact versions from package-lock.json (reproducible builds)
RUN npm ci

# ── Stage 2: Build the Next.js application ────────────────────────────────────
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# next build generates .next/standalone/ because of output: 'standalone' in next.config.mjs
RUN npm run build

# ── Stage 3: Production runner (minimal image) ────────────────────────────────
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
# Disable Next.js anonymous telemetry in production
ENV NEXT_TELEMETRY_DISABLED=1

# Create a non-root system user for security (principle of least privilege)
RUN addgroup --system --gid 1001 nodejs && \
    adduser  --system --uid 1001 nextjs

# Copy only what's needed to run (not source, not build tools, not node_modules)
COPY --from=builder /app/public ./public

# Standalone server — everything needed to run next start without node_modules
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./

# Static assets served directly by Next.js (no CDN required for self-host)
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Switch to non-root user before starting the server
USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Docker healthcheck — docker-compose depends_on uses this to wait for readiness
# wget is available in alpine; curl is not installed by default
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost:3000/api/health || exit 1

# Start the standalone Next.js server (generated by next build with output:'standalone')
CMD ["node", "server.js"]
