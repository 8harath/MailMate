# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost

# ── Groq LLM ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=mailmate
POSTGRES_USER=mailmate
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://mailmate:change_me_strong_password@postgres:5432/mailmate

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Inter-service auth ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AGENT_SERVICE_TOKEN=generate_with_openssl_rand_hex_32
AGENT_SERVICE_URL=http://agent-service:8000

# ── Supabase (optional legacy — leave blank to use Postgres directly) ─────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Observability (optional) ──────────────────────────────────────────────────
LANGSMITH_API_KEY=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost
