# MailMate — Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# Required variables are marked [REQUIRED].
# Optional variables are marked [OPTIONAL] — the app degrades gracefully.

# ─── Groq AI ─────────────────────────────────────────────────────
# [REQUIRED] Powers all AI features: analysis, drafts, chat agents.
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Google OAuth (Gmail + Calendar) ─────────────────────────────
# [REQUIRED] Enables Gmail integration and Google Calendar sync.
# Steps:
#  1. Go to https://console.cloud.google.com/apis/credentials
#  2. Create an OAuth 2.0 Client ID (Web application)
#  3. Add authorised redirect URI: http://localhost:3000/api/auth/callback/google
#  4. Enable Gmail API and Google Calendar API in the console
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxx

# ─── NextAuth ────────────────────────────────────────────────────
# [REQUIRED] Session encryption secret. Must be at least 32 characters.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-32-character-secret-here

# [REQUIRED] The canonical URL of your deployment.
# Local: NEXTAUTH_URL=http://localhost:3000
# Production: NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────────
# [OPTIONAL] Enables persistent storage: analysis cache, thread metadata,
# custom labels, agent memory, automation history.
# Without Supabase the app uses localStorage only (data lost on logout).
#
# Steps:
#  1. Create a project at https://supabase.com
#  2. In the Supabase SQL editor, run both migrations:
#       scripts/migration-agent-memory.sql
#       scripts/migration-automation.sql
#  3. Copy the URL and keys from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
